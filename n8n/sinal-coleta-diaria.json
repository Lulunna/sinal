    {
      "id": "20881fdc-916b-5e87-af87-bd77aa00ddd3",
      "name": "Montar pedido de coleta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        80
      ],
      "parameters": {
        "jsCode": "const cfg=$('Config').first().json;\nconst sources=$('Fontes ativas').all().map(i=>i.json).filter(s=>s.url);\nconst known=$('Artigos já salvos').all().map(i=>i.json.url).filter(Boolean);\nreturn [{json:{started_at:new Date().toISOString(),collect:{sources,known_urls:known,since_hours:cfg.since_hours}}}];"
      },
      "executeOnce": true
    },
    {
      "id": "6ff9dfec-a840-5063-b147-34442d980ecb",
      "name": "Python: coletar",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        80
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.api_base }}/api/collect",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.collect) }}",
        "options": {
          "timeout": 90000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
