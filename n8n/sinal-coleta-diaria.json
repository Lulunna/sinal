    {
      "id": "76b04640-bf2d-57fa-80d0-98339a7740fd",
      "name": "Resumo da rodada",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2880,
        240
      ],
      "parameters": {
        "jsCode": "const calls=$input.all().map(i=>i.json).filter(x=>x&&x.status);\nconst base=$('Montar pedido de ranking').first().json;\nconst kept=$('Um item por notícia').first().json._kept??0;\nreturn [{json:{\n  started_at:$('Montar pedido de coleta').first().json.started_at,\n  finished_at:new Date().toISOString(),\n  collected:base.fetched||base.collected,\n  kept:kept,\n  summarized:calls.filter(c=>c.status==='ok').length,\n  errors:calls.filter(c=>c.status==='error').length,\n  cost_usd:Math.round(calls.reduce((s,c)=>s+Number(c.cost_usd||0),0)*1e6)/1e6}}];"
      },
      "executeOnce": true
    },
