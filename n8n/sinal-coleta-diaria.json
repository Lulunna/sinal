    {
      "id": "efe5f19f-35b2-5f2f-8f4a-c83abaf3142b",
      "name": "Um item por notícia",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2160,
        80
      ],
      "parameters": {
        "jsCode": "const r=$input.first().json;\nif(!r.items||!r.items.length) return [{json:{_empty:true,kept:0}}];\nreturn r.items.map(x=>({json:{...x,_kept:r.kept}}));"
      },
      "executeOnce": true
    },
    {
      "id": "ce1ea098-7ec5-5095-b116-d4ea3af31fb2",
