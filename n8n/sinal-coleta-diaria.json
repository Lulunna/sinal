          "name": "Sinal API key"
        }
      }
    },
    {
      "id": "d1955807-0c5c-520a-9c11-6cad9dfe78bb",
      "name": "Montar pedido de ranking",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        80
      ],
      "parameters": {
        "jsCode": "const cfg=$('Config').first().json;\nconst J=$input.first().json;const items=J.items||[];\nconst interests=$('Interesses').all().map(i=>i.json).filter(x=>x.topic);\nreturn [{json:{collected:items.length,fetched:(J.stats||{}).fetched||items.length,rank:{items,interests,min_score:cfg.min_score,top:cfg.top_n}}}];"
      },
      "executeOnce": true
    },
    {
      "id": "f9b02ae0-3558-5bc2-a8f6-360adbf89619",
