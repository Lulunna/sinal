      "parameters": {
        "jsCode": "const cfg=$('Config').first().json;\nconst t=$('Validar').first().json.test;\nconst a=$('Uma por vez').item.json;\nconst prompt=t.prompt_a+`\\n\\nTítulo: ${a.title}\\nTexto: ${a.excerpt}`;\nreturn {json:{_t0:Date.now(),_model:cfg.model,_body:{contents:[{parts:[{text:prompt}]}],generationConfig:{temperature:0.3}}}};",
        "mode": "runOnceForEachItem"
      }
