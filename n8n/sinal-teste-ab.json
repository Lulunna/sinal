    {
      "id": "9e6eb2e5-e66e-5b8a-bcef-9831273e9a31",
      "name": "Medir juiz",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4560,
        -160
      ],
      "parameters": {
        "jsCode": "const PRICES={'gemini-2.5-flash':[0.30,2.50],'gemini-2.5-flash-lite':[0.10,0.40],'gemini-2.0-flash':[0.10,0.40],'gemini-2.5-pro':[1.25,10]};\nconst cost=(m,i,o)=>{const p=PRICES[m]||[0,0];return Math.round(((i||0)*p[0]+(o||0)*p[1])/1e6*1e6)/1e6;};\nconst src=$('Preparar juiz').item.json, r=$json, u=r.usageMetadata||{};\nconst a=$('Uma por vez').item.json, A=$('Medir A').item.json, B=$('Medir B').item.json;\nlet err=null,s1=null,s2=null;\ntry{ if(r.error) throw new Error(typeof r.error==='string'?r.error:(r.error.message||'erro'));\n  const j=JSON.parse((((r.candidates||[])[0]||{}).content||{}).parts?.[0]?.text||'');\n  s1=Number(j.nota_1); s2=Number(j.nota_2);\n  if(![s1,s2].every(x=>x>=1&&x<=5)) throw new Error('nota fora de 1 a 5'); }catch(e){err=String(e.message||e).slice(0,300);}\nconst o=(u.candidatesTokenCount||0)+(u.thoughtsTokenCount||0);\nconst judge={workflow:'teste-ab',step:'avaliacao',model:src._model,prompt_version:null,input_tokens:u.promptTokenCount||0,output_tokens:o,\n latency_ms:Date.now()-src._t0,cost_usd:cost(src._model,u.promptTokenCount||0,o),status:err?'error':'ok',error:err};\nconst aScore=err?null:(src._flip?s2:s1), bScore=err?null:(src._flip?s1:s2);\nreturn {json:{calls:[A.call,B.call,judge].map(c=>({...c,article_id:a.article_id})),\n sample:{title:a.title,a_text:A.text,b_text:B.text,a_score:aScore,b_score:bScore,a_cost:A.call.cost_usd,b_cost:B.call.cost_usd,\n  a_lat:A.call.latency_ms,b_lat:B.call.latency_ms,a_out:A.call.output_tokens,b_out:B.call.output_tokens,\n  extra_cost:judge.cost_usd}}};",
        "mode": "runOnceForEachItem"
      }
    },
