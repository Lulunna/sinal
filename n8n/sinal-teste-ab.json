      "onError": "continueRegularOutput"
    },
    {
      "id": "ff837982-d7b6-5ebd-b69a-8702ae2c30c7",
      "name": "Medir A",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2640,
        -160
      ],
      "parameters": {
        "jsCode": "const PRICES={'gemini-2.5-flash':[0.30,2.50],'gemini-2.5-flash-lite':[0.10,0.40],'gemini-2.0-flash':[0.10,0.40],'gemini-2.5-pro':[1.25,10]};\nconst cost=(m,i,o)=>{const p=PRICES[m]||[0,0];return Math.round(((i||0)*p[0]+(o||0)*p[1])/1e6*1e6)/1e6;};\nconst src=$('Preparar A').item.json, r=$json, u=r.usageMetadata||{};\nlet text='',err=null;\ntry{ if(r.error) throw new Error(typeof r.error==='string'?r.error:(r.error.message||'erro')); text=(((r.candidates||[])[0]||{}).content||{}).parts?.[0]?.text||''; if(!text) throw new Error('resposta vazia'); }catch(e){err=String(e.message||e).slice(0,300);}\nconst o=(u.candidatesTokenCount||0)+(u.thoughtsTokenCount||0);\nreturn {json:{text,call:{workflow:'teste-ab',step:'resposta-a',model:src._model,prompt_version:null,input_tokens:u.promptTokenCount||0,output_tokens:o,\n latency_ms:Date.now()-src._t0,cost_usd:cost(src._model,u.promptTokenCount||0,o),status:err?'error':'ok',error:err}}};",
        "mode": "runOnceForEachItem"
      }
    },
