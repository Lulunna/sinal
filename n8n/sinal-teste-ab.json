    {
      "id": "085894a4-ebfa-5060-b41c-52b92310c6eb",
      "name": "Preparar juiz",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4080,
        -160
      ],
      "parameters": {
        "jsCode": "const cfg=$('Config').first().json;\nconst a=$('Uma por vez').item.json;\nconst A=$('Medir A').item.json.text, B=$('Medir B').item.json.text;\nconst flip=Math.random()<0.5;               // sorteia a ordem para a avaliadora não favorecer a posição\nconst r1=flip?B:A, r2=flip?A:B;\nconst prompt=`Você avalia resumos de notícias. Leia o texto original e as duas respostas. Dê nota de 1 a 5 para cada uma (5 = fiel ao texto, clara, útil e no tamanho certo; 1 = errada, vaga ou inventada). Não prefira uma resposta por vir primeiro. Responda SOMENTE JSON: {\"nota_1\":número,\"nota_2\":número}\n\nTEXTO ORIGINAL:\n${a.title}\n${a.excerpt}\n\nRESPOSTA 1:\n${r1}\n\nRESPOSTA 2:\n${r2}`;\nreturn {json:{_t0:Date.now(),_flip:flip,_model:cfg.judge_model,_body:{contents:[{parts:[{text:prompt}]}],generationConfig:{temperature:0,responseMimeType:'application/json'}}}};",
        "mode": "runOnceForEachItem"
      }
    },
    {
      "id": "94073a0c-30a8-5664-b9be-9ea21fbdcd95",
      "name": "Gemini: juiz",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        4320,
        -160
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/{{ $('Preparar juiz').item.json._model }}:generateContent",
