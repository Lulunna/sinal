    {
      "id": "8900806f-448b-5576-b1e4-c95513512301",
      "name": "Agregar resultado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        160
      ],
      "parameters": {
        "jsCode": "const cfg=$('Config').first().json;\nconst S=$input.all().map(i=>i.json.sample).filter(Boolean);\nconst avg=(arr)=>arr.length?arr.reduce((x,y)=>x+y,0)/arr.length:0;\nconst r=(x,d)=>Math.round(x*10**d)/10**d;\nconst side=(k)=>{const sc=S.map(s=>s[k+'_score']).filter(x=>x!=null);\n  return {avg_score:r(avg(sc),2),avg_cost:r(avg(S.map(s=>s[k+'_cost'])),6),avg_latency_ms:Math.round(avg(S.map(s=>s[k+'_lat']))),avg_output_tokens:Math.round(avg(S.map(s=>s[k+'_out'])))};};\nconst a=side('a'), b=side('b');\nconst d=b.avg_score-a.avg_score;\nconst winner=!S.length||Math.abs(d)<0.3?'empate':(d>0?'B':'A');   // diferença menor que 0,3 ponto = empate\nconst result={n:S.length,judge_model:cfg.judge_model,winner,a,b,samples:S.slice(0,3).map(s=>({title:s.title,a_text:s.a_text,b_text:s.b_text,a_score:s.a_score,b_score:s.b_score}))};\nreturn [{json:{status:S.length?'done':'error',result}}];"
      },
      "executeOnce": true
    },
